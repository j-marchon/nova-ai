# Build output. Generated by `npm run build`; not tracked, so building
# locally never blocks a git pull.
dist/

# Dependencies. Installed by `npm install`; not tracked, for the same reason
# as dist/ and because the tracked copy held Windows-only native binaries.
node_modules/

# Local secrets & OAuth tokens for Nova Bridge.
.env
.nova-bridge-auth.json
.nova-bridge-auth.json.devices
.nova-bridge-auth.json.devices.tmp
.nova-bridge-auth.json.tmp
.nova-bridge-auth.json.browser/
.nova-bridge-auth.json.sync/

# Local reference checkout and test output
sillytavern/
*-tests.log

# Secrets, signing keys and build artifacts
.env.*
!.env.example
*.keystore
*.jks
*.apk
*.aab
.claude/settings.local.json

# desktop packaging
/build/
/release/

# Finished desktop installers (npm run build:desktop)
/out/

# design-tool scratch (Impeccable)
.impeccable/

# Python caches
__pycache__/
